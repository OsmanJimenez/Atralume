        "on-surface": {
          "$value": "{atr.ref.color.neutral.10}"
        },
        "surface-variant": {
          "$value": "{atr.ref.color.neutral-variant.90}"
        },
        "on-surface-variant": {
          "$value": "{atr.ref.color.neutral-variant.30}"
        },
        "surface-container-lowest": {
          "$value": "{atr.ref.color.neutral.100}"
