        "surface-container": { "$value": "{atr.ref.color.neutral.94}" },
        "surface-container-high": { "$value": "{atr.ref.color.neutral.90}" },
        "surface-container-highest": { "$value": "{atr.ref.color.neutral.80}" },
        "outline": { "$value": "{atr.ref.color.neutral-variant.50}" },
        "outline-variant": { "$value": "{atr.ref.color.neutral-variant.80}" },
        "inverse-surface": { "$value": "{atr.ref.color.neutral.20}" },
        "inverse-on-surface": { "$value": "{atr.ref.color.neutral.96}" },
        "inverse-primary": { "$value": "{atr.ref.color.primary.80}" },
        "scrim": { "$value": "{atr.ref.color.neutral.0}" },
        "shadow": { "$value": "{atr.ref.color.neutral.0}" },
        "focus": { "$value": "{atr.ref.color.primary.40}" }
      }
    }
  }
