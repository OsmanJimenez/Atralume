        },
        "outline-variant": {
          "$value": "{atr.ref.color.neutral-variant.80}"
        },
        "inverse-surface": {
          "$value": "{atr.ref.color.neutral.20}"
        },
        "inverse-on-surface": {
          "$value": "{atr.ref.color.neutral.96}"
        },
        "inverse-primary": {
          "$value": "{atr.ref.color.primary.80}"
        },
        "scrim": {
          "$value": "{atr.ref.color.neutral.0}"
        },
        "shadow": {
          "$value": "{atr.ref.color.neutral.0}"
        },
        "focus": {
          "$value": "{atr.ref.color.primary.40}"
        },
        "success": {
          "$value": "{atr.ref.color.success.40}"
        },
        "on-success": {
          "$value": "{atr.ref.color.success.100}"
        },
        "success-container": {
          "$value": "{atr.ref.color.success.90}"
        },
        "on-success-container": {
          "$value": "{atr.ref.color.success.10}"
        },
        "warning": {
          "$value": "{atr.ref.color.warning.40}"
        },
        "on-warning": {
          "$value": "{atr.ref.color.warning.100}"
        },
        "warning-container": {
          "$value": "{atr.ref.color.warning.90}"
        },
        "on-warning-container": {
          "$value": "{atr.ref.color.warning.10}"
        },
        "info": {
          "$value": "{atr.ref.color.info.40}"
        },
        "on-info": {
          "$value": "{atr.ref.color.info.100}"
        },
        "info-container": {
          "$value": "{atr.ref.color.info.90}"
        },
        "on-info-container": {
          "$value": "{atr.ref.color.info.10}"
        }
      },
      "navigation": {
        "item": {
          "active-container-color": {
            "$type": "color",
            "$value": "{atr.sys.color.primary-container}"
          },
          "active-label-color": {
            "$type": "color",
            "$value": "{atr.sys.color.on-primary-container}"
          },
          "focus-color": {
            "$type": "color",
            "$value": "{atr.sys.color.focus}"
          }
        }
      },
      "feedback": {
        "container-color": {
          "$type": "color",
          "$value": "{atr.sys.color.inverse-surface}"
        },
        "label-color": {
          "$type": "color",
          "$value": "{atr.sys.color.inverse-on-surface}"
        }
      },
      "disclosure": {
        "container-color": {
          "$type": "color",
          "$value": "{atr.sys.color.surface-container}"
        },
        "label-color": {
          "$type": "color",
          "$value": "{atr.sys.color.on-surface}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{atr.sys.color.outline-variant}"
        }
      },
      "overlay": {
        "backdrop-color": {
          "$type": "color",
          "$value": "{atr.sys.color.scrim}"
        }
      }
    }
  }
}
