{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "atr": {
    "comp": {
      "button": {
        "container": {
          "color": {
            "$type": "color",
            "$value": "{atr.sys.color.primary}"
          },
          "radius": {
            "$type": "dimension",
            "$value": "{atr.sys.shape.full}"
          },
          "height": {
            "$type": "dimension",
            "$value": "{atr.sys.touch-target.minimum}"
          },
          "padding-inline": {
            "$type": "dimension",
            "$value": "{atr.sys.spacing.lg}"
          }
        },
        "label": {
          "color": {
            "$type": "color",
            "$value": "{atr.sys.color.on-primary}"
          },
          "font-family": {
            "$type": "fontFamily",
            "$value": "{atr.ref.font.family.plain}"
          },
          "font-size": {
            "$type": "dimension",
            "$value": "{atr.ref.font.size.14}"
          },
          "font-weight": {
            "$type": "fontWeight",
            "$value": "{atr.ref.font.weight.medium}"
          },
          "letter-spacing": {
            "$type": "dimension",
            "$value": "{atr.ref.font.tracking.wide}"
          }
        },
        "state-layer": {
          "color": {
            "$type": "color",
            "$value": "{atr.sys.color.on-primary}"
          }
        },
        "disabled": {
          "container-opacity": {
            "$type": "number",
            "$value": "{atr.sys.state.disabled-opacity}"
          },
          "content-opacity": {
            "$type": "number",
            "$value": "{atr.sys.state.disabled-content-opacity}"
          }
        },
        "gap": {
          "$type": "dimension",
          "$value": "{atr.sys.spacing.sm}"
        },
        "outline-color": {
          "$type": "color",
          "$value": "{atr.sys.color.outline}"
        },
        "focus-ring-color": {
          "$type": "color",
          "$value": "{atr.sys.color.focus}"
        },
        "focus-ring-width": {
          "$type": "dimension",
          "$value": "{atr.sys.focus-ring.width}"
        },
        "motion-duration": {
          "$type": "duration",
          "$value": "{atr.sys.motion.duration.short}"
        },
        "motion-easing": {
          "$type": "cubicBezier",
          "$value": "{atr.sys.motion.easing.standard}"
        },
        "height-small": {
          "$type": "dimension",
          "$value": "{atr.sys.touch-target.minimum}"
        },
        "height-large": {
          "$type": "dimension",
          "$value": "{atr.ref.spacing.16}"
        },
        "spinner-duration": {
          "$type": "duration",
          "$value": "{atr.ref.duration.activity}"
        },
        "reduced-motion-duration": {
          "$type": "duration",
          "$value": "{atr.ref.duration.activity-reduced}"
        },
        "hover-opacity": {
          "$type": "number",
          "$value": "{atr.sys.state.hover-opacity}"
        },
        "pressed-opacity": {
          "$type": "number",
          "$value": "{atr.sys.state.pressed-opacity}"
        }
      }
    }
  }
}
