{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "atr": {
    "ref": {
      "font": {
        "family": {
          "$type": "fontFamily",
          "brand": { "$value": ["Inter", "Roboto", "system-ui", "sans-serif"] },
          "plain": { "$value": ["Inter", "Roboto", "system-ui", "sans-serif"] }
        },
        "weight": {
          "$type": "fontWeight",
          "regular": { "$value": 400 },
          "medium": { "$value": 500 },
          "bold": { "$value": 700 }
        },
        "size": {
          "$type": "dimension",
          "11": { "$value": { "value": 0.6875, "unit": "rem" } },
          "12": { "$value": { "value": 0.75, "unit": "rem" } },
          "14": { "$value": { "value": 0.875, "unit": "rem" } },
          "16": { "$value": { "value": 1, "unit": "rem" } },
          "22": { "$value": { "value": 1.375, "unit": "rem" } },
          "24": { "$value": { "value": 1.5, "unit": "rem" } },
          "28": { "$value": { "value": 1.75, "unit": "rem" } },
          "32": { "$value": { "value": 2, "unit": "rem" } },
          "36": { "$value": { "value": 2.25, "unit": "rem" } },
          "45": { "$value": { "value": 2.8125, "unit": "rem" } },
          "57": { "$value": { "value": 3.5625, "unit": "rem" } }
        },
        "line-height": {
          "$type": "number",
          "tight": { "$value": 1.1 },
          "title": { "$value": 1.25 },
          "body": { "$value": 1.5 }
        },
        "tracking": {
          "$type": "dimension",
          "tight": { "$value": { "value": -0.025, "unit": "rem" } },
          "normal": { "$value": { "value": 0, "unit": "rem" } },
          "wide": { "$value": { "value": 0.00625, "unit": "rem" } }
        }
      }
    }
  }
}
