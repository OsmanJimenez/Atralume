{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "atr": {
    "ref": {
      "duration": {
        "$type": "duration",
        "instant": { "$value": { "value": 0, "unit": "ms" } },
        "short": { "$value": { "value": 180, "unit": "ms" } },
        "medium": { "$value": { "value": 300, "unit": "ms" } },
        "long": { "$value": { "value": 500, "unit": "ms" } }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": { "$value": [0.2, 0, 0, 1] },
        "emphasized": { "$value": [0.2, 0, 0, 1] },
        "decelerate": { "$value": [0.05, 0.7, 0.1, 1] },
        "accelerate": { "$value": [0.3, 0, 0.8, 0.15] }
      },
      "opacity": {
        "$type": "number",
        "hover": { "$value": 0.08 },
        "focus": { "$value": 0.12 },
        "pressed": { "$value": 0.12 },
        "dragged": { "$value": 0.16 },
        "disabled": { "$value": 0.12 },
        "disabled-content": { "$value": 0.38 },
        "glass": { "$value": 0.88 },
        "noise": { "$value": 0 }
      }
    }
  }
}
