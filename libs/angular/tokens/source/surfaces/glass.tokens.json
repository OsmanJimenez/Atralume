{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "atr": {
    "sys": {
      "glass": {
        "background": { "$type": "color", "$value": "#fef7ffe0" },
        "fallback-background": {
          "$type": "color",
          "$value": "{atr.sys.color.surface-container}"
        },
        "border-color": {
          "$type": "color",
          "$value": "{atr.sys.color.outline-variant}"
        },
        "border-width": {
          "$type": "dimension",
          "$value": "{atr.ref.border-width.thin}"
        },
        "blur": { "$type": "dimension", "$value": "{atr.ref.blur.glass}" },
        "saturation": { "$type": "number", "$value": 1.25 },
        "shadow": { "$type": "shadow", "$value": "{atr.ref.shadow.level-2}" },
        "highlight": { "$type": "color", "$value": "#ffffff66" },
        "noise-opacity": {
          "$type": "number",
          "$value": "{atr.ref.opacity.noise}"
        }
      }
    }
  }
}
