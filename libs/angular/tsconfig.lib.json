{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "button/src/**/*.ts",
    "form-field/src/**/*.ts",
    "input/src/**/*.ts",
    "textarea/src/**/*.ts",
    "checkbox/src/**/*.ts",
    "radio/src/**/*.ts",
    "switch/src/**/*.ts",
    "icon/src/**/*.ts",
    "icon-button/src/**/*.ts",
    "link/src/**/*.ts",
    "badge/src/**/*.ts",
    "avatar/src/**/*.ts",
    "divider/src/**/*.ts",
    "progress/src/**/*.ts",
    "card/src/**/*.ts",
    "chip/src/**/*.ts",
    "list/src/**/*.ts",
    "accordion/src/**/*.ts",
    "skeleton/src/**/*.ts",
    "tooltip/src/**/*.ts",
    "menu/src/**/*.ts",
    "dialog/src/**/*.ts",
    "bottom-sheet/src/**/*.ts",
    "snackbar/src/**/*.ts",
    "tabs/src/**/*.ts",
    "breadcrumbs/src/**/*.ts",
    "pagination/src/**/*.ts",
    "navigation-bar/src/**/*.ts",
    "side-navigation/src/**/*.ts",
    "fab/src/**/*.ts",
    "speed-dial/src/**/*.ts",
    "listbox/src/**/*.ts",
    "combobox/src/**/*.ts",
    "select/src/**/*.ts",
    "autocomplete/src/**/*.ts",
    "popover/src/**/*.ts",
    "command-palette/src/**/*.ts",
    "calendar/src/**/*.ts",
    "date-picker/src/**/*.ts",
    "time-picker/src/**/*.ts",
    "slider/src/**/*.ts",
    "file-upload/src/**/*.ts",
    "stepper/src/**/*.ts",
    "table/src/**/*.ts",
    "tree/src/**/*.ts",
    "carousel/src/**/*.ts",
    "internal/forms/src/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.stories.ts",
    "**/*.stories.js"
  ]
}
