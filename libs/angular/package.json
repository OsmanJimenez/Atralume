{
  "name": "@atralume/angular",
  "version": "0.1.0",
  "description": "Accessible Angular 22 design-system components and design tokens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OsmanJimenez/Atralume.git"
  },
  "homepage": "https://osmanjimenez.github.io/Atralume/",
  "bugs": {
    "url": "https://github.com/OsmanJimenez/Atralume/issues"
  },
  "keywords": [
    "angular",
    "design-system",
    "accessibility",
    "wcag"
  ],
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=11.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "fesm2022/*.mjs",
    "types/*.d.ts",
    "styles/**",
    "*/package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@angular/core": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@taiga-ui/cdk": "^5.31.0",
    "@taiga-ui/core": "^5.31.0",
    "@taiga-ui/kit": "^5.31.0",
    "@taiga-ui/layout": "^5.31.0",
    "@taiga-ui/addon-table": "^5.31.0",
    "@taiga-ui/polymorpheus": "^5.0.1",
    "rxjs": "^7.8.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles": {
      "sass": "./styles/index.scss",
      "style": "./styles/theme.css",
      "default": "./styles/index.scss"
    },
    "./styles/theme.css": {
      "style": "./styles/theme.css",
      "default": "./styles/theme.css"
    },
    "./styles/tokens.json": {
      "default": "./styles/generated/token-manifest.json"
    }
  },
  "peerDependenciesMeta": {
    "@angular/forms": {
      "optional": true
    }
  }
}
