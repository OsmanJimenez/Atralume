{
  "name": "atralume-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "scripts": {
    "start": "nx serve playground",
    "storybook": "nx storybook angular --port=6006",
    "build": "nx build angular",
    "build:playground": "nx build playground --configuration=production",
    "build:storybook": "nx build-storybook angular --configuration=ci",
    "lint": "nx run-many -t lint --all",
    "format:check": "nx format:check --all",
    "check:architecture": "node tools/check-architecture.mjs",
    "test:unit": "nx run-many -t test --all --watch=false",
    "check:package": "node tools/check-package.mjs",
    "check:storybook": "node tools/check-storybook.mjs",
    "tokens:build": "node tools/tokens.mjs build",
    "tokens:clean": "node tools/tokens.mjs clean",
    "tokens:check": "node tools/tokens.mjs check",
    "tokens:inspect": "node tools/tokens.mjs inspect",
    "lint:styles": "stylelint \"{apps,libs}/**/*.{css,scss}\"",
    "test:themes": "node tools/check-themes.mjs",
    "verify": "npm run format:check && npm run lint && npm run lint:styles && npm run check:architecture && npm run check:atom-docs && npm run check:component-docs && npm run tokens:check && npm run tokens:build && npm run test:unit && npm run build && npm run build:playground && npm run build:storybook && npm run test:themes && npm run check:package && npm run check:storybook && npm run test:atoms && npm run test:forms && npm run test:phase3 && npm run test:phase4",
    "test:forms": "node tools/check-forms.mjs",
    "test:atoms": "node tools/check-atoms.mjs && node tools/check-atoms-contexts.mjs",
    "check:atom-docs": "node tools/atom-docs.mjs",
    "test:phase3": "node tools/check-phase3.mjs && node tools/check-phase3-contexts.mjs",
    "check:component-docs": "node tools/component-docs.mjs",
    "test:phase4": "node tools/check-phase4.mjs && node tools/check-phase4-contexts.mjs",
    "catalog:audit": "node tools/audit-catalog.mjs",
    "api:check": "node tools/check-public-api.mjs",
    "bundle:check": "node tools/check-bundles.mjs",
    "sbom": "node tools/generate-sbom.mjs",
    "release:status": "changeset status --since=origin/develop --output=dist/release/changeset-status.json",
    "release:version:dry-run": "nx release version --dry-run",
    "release:dry-run": "node tools/release-dry-run.mjs"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.4",
    "@angular-devkit/core": "22.2.4",
    "@angular-devkit/schematics": "22.2.4",
    "@angular/animations": "22.2.4",
    "@angular/aria": "22.2.4",
    "@angular/build": "22.2.4",
    "@angular/cdk": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@angular/router": "22.2.4",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.1",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/storybook": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@schematics/angular": "22.2.4",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/angular": "10.6.5",
    "@swc/helpers": "0.5.23",
    "@taiga-ui/addon-table": "5.31.0",
    "@taiga-ui/cdk": "^5.31.0",
    "@taiga-ui/core": "^5.31.0",
    "@taiga-ui/icons": "^5.31.0",
    "@taiga-ui/kit": "^5.31.0",
    "@taiga-ui/layout": "^5.31.0",
    "@taiga-ui/polymorpheus": "^5.0.1",
    "@typescript-eslint/utils": "8.72.1",
    "angular-eslint": "22.5.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "jsdom": "27.4.0",
    "jsonc-eslint-parser": "2.4.2",
    "less": "4.9.1",
    "ng-packagr": "22.2.4",
    "nx": "23.2.1",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "rxjs": "7.8.2",
    "storybook": "10.6.5",
    "style-dictionary": "5.7.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "ts-node": "10.9.2",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.11",
    "zone.js": "0.16.3"
  },
  "nx": {
    "includedScripts": []
  }
}
