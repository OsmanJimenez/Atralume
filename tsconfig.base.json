{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "module": "preserve",
    "resolveJsonModule": true,
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@atralume/angular": ["./libs/angular/src/index.ts"],
      "@atralume/angular/button": ["./libs/angular/button/src/index.ts"]
    }
  }
}
